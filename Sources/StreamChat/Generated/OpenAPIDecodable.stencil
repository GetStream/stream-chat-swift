{# A property decodes from the StringCodingKey named after it without `_`: a stored `_x` is the generator's backing property for a deprecated `x`, decodes from `.x`, and defaultValues refers to it as `x`. StringCodingKey names follow the wire keys, so a property that rename_property moved away from its wire key's name would decode the wrong key; rename_property refuses models listed in sources. #}
{% for type in types.classes %}
// sourcery:decoder:{{ type.name }}
{% if type.name in argument.allKeys %}
    static let allKeys: Set<String> = [
{% for stored in type.storedVariables %}
        StringCodingKey.{{ stored.name|replace:"_","" }}.stringValue{% if not forloop.last %},{% endif %}
{% endfor %}
    ]

{% endif %}
    {% if not type.isFinal %}required {% endif %}init(from decoder: Decoder) throws {
        let container = try decoder.container(keyedBy: StringCodingKey.self)
{% for variable in type.storedVariables %}
{% set key %}{{ variable.name|replace:"_","" }}{% endset %}
{% if argument.embedded[type.name] == key %}
        {{ variable.name }} = try {{ variable.typeName.name }}(from: decoder)
{% elif argument.defaultValues[type.name][key] %}
        {{ variable.name }} = try container.decodeIfPresent({{ variable.typeName.name }}.self, forKey: .{{ key }}) ?? {{ argument.defaultValues[type.name][key] }}
{% elif variable.isOptional %}
        {{ variable.name }} = try container.decodeIfPresent({{ variable.typeName.unwrappedTypeName }}.self, forKey: .{{ key }})
{% else %}
        {{ variable.name }} = try container.decode({{ variable.typeName.name }}.self, forKey: .{{ key }})
{% endif %}
{% endfor %}
    }
{% endfor %}
