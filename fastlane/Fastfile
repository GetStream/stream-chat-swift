  )
end

lane :xcmetrics do |options|
  next unless is_check_required(sources: sources_matrix[:xcmetrics], force_check: @force_check)

  ['test_output/', 'metrics/', "../#{derived_data_path}/Build/Products"].each { |dir| FileUtils.remove_dir(dir, force: true) }

  match_me

  scan(
    project: xcode_project,
    scheme: 'StreamChatUITestsApp',
    testplan: 'Performance',
    result_bundle: true,
    derived_data_path: derived_data_path,
    cloned_source_packages_path: source_packages_path,
    clean: is_localhost,
    sdk: 'iphoneos',
    skip_detect_devices: true,
    build_for_testing: true,
    xcodebuild_formatter: xcodebuild_formatter
  )

  firebase_error = ''
  xcodebuild_output = ''
  ios_version = '16.6'
  device_model = 'iphone14pro'
  Dir.chdir("../#{derived_data_path}/Build/Products") do
    begin
      sh("zip -r MyTests.zip .")
      sh("gcloud firebase test ios run --project #{github_repo.split('/').last} --test MyTests.zip --timeout 7m --results-dir test_output --device 'model=#{device_model},version=#{ios_version},orientation=portrait'")
    rescue StandardError => e
      UI.error("Test failed on Firebase:\n#{e}")
      firebase_error = e
    end

    sh("gsutil cp -r #{testlab_bucket}/test_output/#{device_model}-#{ios_version}-en-portrait/xcodebuild_output.log xcodebuild_output.log")
    xcodebuild_output = File.read('xcodebuild_output.log')
  end

  warning_status = '🟡' # Warning if a branch is #{max_tolerance} less performant than the benchmark
  fail_status = '🔴' # Failure if a branch is more than #{max_tolerance} less performant than the benchmark
  success_status = '🟢' # Success if a branch is more performant or equals to the benchmark

  sh("git clone #{metrics_git} #{File.dirname(xcmetrics_path)}")
  performance_benchmarks = JSON.parse(File.read(xcmetrics_path))
  expected_performance = performance_benchmarks['benchmark']
  actual_performance = xcmetrics_log_parser(log: xcodebuild_output)

  table_header = '## SDK Performance'
  markdown_table = "#{table_header}\n| `target` | `metric` | `benchmark` | `branch` | `performance` | `status` |\n| - | - | - | - | - | - |\n"
  ['testMessageListScrollTime', 'testChannelListScrollTime'].each do |test_name|
    next if test_name == 'testChannelListScrollTime' # Delete this line and return the test to the testplan as soon as PBE-5666 is solved

    index = 0
    ['hitches_total_duration', 'duration', 'hitch_time_ratio', 'frame_rate', 'number_of_hitches'].each do |metric|
      is_frame_rate = metric == 'frame_rate'
      benchmark_value = expected_performance[test_name][metric]['value']
      branch_value = actual_performance[test_name][metric]['value']
      value_extension = actual_performance[test_name][metric]['ext']
      max_tolerance = benchmark_value * 0.1 # Default Xcode Max Tolerance is 10%

      benchmark_value_avoids_zero_division = benchmark_value == 0 ? 1 : benchmark_value
      diff = is_frame_rate ? branch_value - benchmark_value : benchmark_value - branch_value
      diff = (diff * 100.0 / benchmark_value_avoids_zero_division).round(2)
      diff_emoji = if diff > 0
                     '🔼'
                   elsif diff.zero?
                     '🟰'
                   else
                     '🔽'
                   end

      status_emoji =
        if is_frame_rate
          if branch_value < benchmark_value && branch_value > benchmark_value - max_tolerance
            warning_status
          elsif branch_value < benchmark_value
            fail_status
          else
            success_status
          end
        else
          if branch_value > benchmark_value && branch_value < benchmark_value + max_tolerance
            warning_status
          elsif branch_value > benchmark_value
            fail_status
          else
            success_status
          end
        end

      title = metric.to_s.gsub('_', ' ').capitalize
      target = index.zero? ? test_name.match(/(?<=test)(.*?)(?=ScrollTime)/).to_s : ''
      index += 1

      markdown_table << "| #{target} | #{title} | #{benchmark_value} #{value_extension} | #{branch_value} #{value_extension} | #{diff}% #{diff_emoji} | #{status_emoji} |\n"
      FastlaneCore::PrintTable.print_values(
        title: title,
        config: {
          benchmark: "#{benchmark_value} #{value_extension}",
          branch: "#{branch_value} #{value_extension}",
          diff: "#{diff}% #{diff_emoji}",
          status: status_emoji
        }
      )
    end
  end

  UI.user_error!("See Firebase error above ☝️") unless firebase_error.to_s.empty?

  pr_comment(text: markdown_table, edit_last_comment_with_text: table_header) if is_ci

  UI.user_error!("#{table_header} benchmark failed.") if markdown_table.include?(fail_status)
end

private_lane :xcmetrics_log_parser do |options|
  log = options[:log]
  method = 'Scroll_DraggingAndDeceleration'
  metrics = {}

  ['testMessageListScrollTime', 'testChannelListScrollTime'].each do |test_name|
    next if test_name == 'testChannelListScrollTime' # Delete this line and return the test to the testplan as soon as PBE-5666 is solved

    hitches_total_duration = log.match(/#{test_name}\]' measured \[Hitches Total Duration \(#{method}\), ms\] average: (\d+\.\d+)/)
    UI.user_error!("Hitches Total Duration not found for #{test_name}") if hitches_total_duration.nil?

    duration = log.match(/#{test_name}\]' measured \[Duration \(#{method}\), s\] average: (\d+\.\d+)/)
    UI.user_error!("Duration not found for #{test_name}") if duration.nil?

    hitch_time_ratio = log.match(/#{test_name}\]' measured \[Hitch Time Ratio \(#{method}\), ms per s\] average: (\d+\.\d+)/)
    UI.user_error!("Hitch Time Ratio not found for #{test_name}") if hitch_time_ratio.nil?

    frame_rate = log.match(/#{test_name}\]' measured \[Frame Rate \(#{method}\), fps\] average: (\d+\.\d+)/)
    UI.user_error!("Frame Rate not found for #{test_name}") if frame_rate.nil?

    number_of_hitches = log.match(/#{test_name}\]' measured \[Number of Hitches \(#{method}\), hitches\] average: (\d+\.\d+)/)
    UI.user_error!("Number of Hitches not found for #{test_name}") if number_of_hitches.nil?

    metrics[test_name] = {
      'hitches_total_duration' => {
        'value' => hitches_total_duration[1].to_f.round(2),
        'ext' => 'ms'
      },
      'duration' => {
        'value' => duration[1].to_f.round(2),
        'ext' => 's'
      },
      'hitch_time_ratio' => {
        'value' => hitch_time_ratio[1].to_f.round(2),
        'ext' => 'ms per s'
      },
      'frame_rate' => {
        'value' => frame_rate[1].to_f.round(2),
        'ext' => 'fps'
      },
      'number_of_hitches' => {
        'value' => number_of_hitches[1].to_f.round(2),
        'ext' => ''
      }
    }
  end

  metrics
end

desc 'Runs e2e ui tests using real backend server in Debug config'
lane :test_e2e do |options|
  scan_options = {
    project: xcode_project,
    scheme: 'StreamChatUITestsApp',
    testplan: 'Backend',
    result_bundle: true,
    derived_data_path: derived_data_path,
    cloned_source_packages_path: source_packages_path,
    clean: is_localhost,
    test_without_building: options[:test_without_building],
    devices: options[:device],
    prelaunch_simulator: is_ci,
    number_of_retries: 3,
    xcodebuild_formatter: xcodebuild_formatter
  }

  begin
    scan(scan_options)
  rescue StandardError
    failed_tests = retreive_failed_tests
    UI.important("Re-running #{failed_tests.size} failed tests ⌛️")
    scan(scan_options.merge(only_testing: failed_tests))
  end
end

desc 'Runs e2e ui tests using mock server in Debug config'
lane :test_e2e_mock do |options|
  next unless is_check_required(sources: sources_matrix[:e2e], force_check: @force_check)

  start_mock_server(local_server: options[:local_server], branch: options[:mock_server_branch])

  scan_options = {
    project: xcode_project,
    scheme: 'StreamChatUITestsApp',
    testplan: 'StreamChatUITestsApp',
    result_bundle: true,
    derived_data_path: derived_data_path,
    cloned_source_packages_path: source_packages_path,
    clean: is_localhost && !options[:test_without_building],
    test_without_building: options[:test_without_building],
    devices: options[:device],
    prelaunch_simulator: is_ci,
    number_of_retries: 3,
    xcodebuild_formatter: xcodebuild_formatter
  }

  if options[:coverage]
    scan(scan_options.merge(build_for_testing: true, code_coverage: true))
    scan_options[:test_without_building] = true
    scan_options[:clean] = false
    FileUtils.rm_rf(e2e_coverage_dir)
    ENV['TEST_RUNNER_E2E_COVERAGE_DIR'] = e2e_coverage_dir
  end

  if ENV['MATRIX_SIZE'] && options[:batch]
    tests = File.exist?(e2e_selection_path) ? JSON.parse(File.read(e2e_selection_path))['tests'] : all_e2e_tests
    slice_size = [(tests.size / ENV['MATRIX_SIZE'].to_f).ceil, 1].max
    only_testing_batch = tests.each_slice(slice_size).to_a[options[:batch].to_i].to_a
    UI.important("Tests in total: #{tests.size}. Running #{only_testing_batch.size} of them ⌛️")
    next if only_testing_batch.empty?

    scan_options[:only_testing] = only_testing_batch
  end

  failed_tests = []
  begin
    scan(scan_options)
  rescue StandardError
    failed_tests = retreive_failed_tests
    UI.important("Re-running #{failed_tests.size} failed tests ⌛️")
    begin
      scan(scan_options.merge(only_testing: failed_tests))
      failed_tests = []
    rescue StandardError
      # The retry overwrote the junit report, so only the tests that failed again stay failed for the coverage map.
      failed_tests = retreive_failed_tests
      raise
    end
  ensure
    build_e2e_coverage_map(failed_tests: failed_tests) if options[:coverage]
  end
end

desc 'Picks the e2e tests the pull request can affect and exposes how many CI batches they need'
lane :select_e2e_tests do |options|
  all_tests = all_e2e_tests
  UI.user_error!('No e2e tests found in the built xctestrun') if all_tests.empty?
  tests = []
  # A manual run's tip may be a "Merge develop" commit, which the selection would mistake for a pull request merge.
  run_all_reason =
    if is_ci && ENV['GITHUB_EVENT_NAME'] != 'pull_request'
      'not a pull request'
    elsif ENV['GITHUB_HEAD_REF'].to_s.start_with?('release/') || ENV['GITHUB_BASE_REF'] == 'main'
      'release pull request'
    end
  if run_all_reason
    UI.important("Running all #{all_tests.size} tests: #{run_all_reason}")
    tests = all_tests
    File.write(e2e_selection_path, JSON.generate(run_all: true, tests: tests, reasons: [run_all_reason]))
  elsif is_check_required(sources: sources_matrix[:e2e], force_check: @force_check)
    selection = select_impacted_tests(
      all_tests: all_tests,
      coverage_map: options[:coverage_map],
      coverage_map_artifact: e2e_coverage_map_artifact,
      diff_base: options[:diff_base],
      changed_files: options[:changed_files]&.split(','),
      source_paths: ['Sources', 'StreamChatUITestsApp'],
      test_paths: ['StreamChatUITestsAppUITests/Tests'],
      ignore_paths: ['**/*.md', '**/*.stencil', '**/*.yml', 'Sources/*/Info.plist'],
      run_all_paths: [
        'StreamChatUITestsAppUITests/Tests/Base TestCase',
        'StreamChatUITestsAppUITests/Extensions',
        'StreamChatUITestsAppUITests/Pages',
        'StreamChatUITestsAppUITests/Robots',
        'StreamChatUITestsAppUITests/StreamChatUITestsApp.xctestplan',
        'StreamChatUITestsAppUITests/StreamChatUITests.swift',
        'TestTools/StreamChatTestMockServer',
        'Package.swift',
        'Package.resolved',
        xcode_project,
        '.github/workflows/smoke-checks.yml',
        'fastlane/Fastfile',
        'Gemfile.lock'
      ],
      # Changes to code nearly every test runs (launch, login, channel list) take one test per class; the nightly run covers the rest.
      hot_test_ratio: 0.9,
      output_path: e2e_selection_path
    )
    tests = selection['tests']
  else
    File.write(e2e_selection_path, JSON.generate(run_all: false, tests: [], reasons: ['no e2e sources changed']))
  end

  # Up to 3 batches, none bigger than a third of the suite, so a small selection takes fewer runners.
  max_batches = 3
  batch_size = (all_tests.size / max_batches.to_f).ceil
  batches = (0...[(tests.size / batch_size.to_f).ceil, max_batches].min).to_a
  UI.important("E2E batches: #{batches.size}")
  File.write(ENV['GITHUB_OUTPUT'], "e2e_batches=#{batches.to_json}\n", mode: 'a') if ENV['GITHUB_OUTPUT']
  batches
end

private_lane :build_e2e_coverage_map do |options|
  next UI.important('No e2e coverage was collected') if Dir.glob("#{e2e_coverage_dir}/*/*/*.profraw").empty?

  app = Dir.glob(File.expand_path("../#{derived_data_path}/Build/Products/*-iphonesimulator/StreamChatUITestsApp.app")).first
  executable = ["#{app}/StreamChatUITestsApp.debug.dylib", "#{app}/StreamChatUITestsApp"].find { |path| File.exist?(path) }
  frameworks = Dir.glob("#{app}/Frameworks/*.framework").map { |framework| "#{framework}/#{File.basename(framework, '.framework')}" }

  build_test_coverage_map(
    coverage_dir: e2e_coverage_dir,
    binaries: [executable] + frameworks,
    output_path: e2e_coverage_map_path,
    previous_map_artifact: e2e_coverage_map_artifact,
    failed_tests: options[:failed_tests]
  )
end

private_lane :all_e2e_tests do
  xctestrun = Dir.glob(File.expand_path("../#{derived_data_path}/Build/Products/*.xctestrun")).first
  retrieve_xctest_names(xctestrun: xctestrun).values.flatten
end

private_lane :retreive_failed_tests do
  report_path = 'test_output/report.junit'
  raise UI.user_error!('There is no junit report to parse') unless File.file?(report_path)

  junit_report = Nokogiri::XML(File.read(report_path))
  failed_tests = []
  passed_tests = []
  suite_name = junit_report.xpath('//testsuite').first['name'].split('.').first
  junit_report.xpath('//testcase').each do |testcase|
    class_name = testcase['classname'].split('.').last
    test_name = testcase['name'].delete('()')

    if testcase.at_xpath('failure')
      failed_tests << "#{suite_name}/#{class_name}/#{test_name}"
    else
      passed_tests << "#{suite_name}/#{class_name}/#{test_name}"
    end
  end

  (failed_tests - passed_tests).uniq
end

desc 'Runs ui tests in Debug config'
lane :test_ui do |options|
  next unless is_check_required(sources: sources_matrix[:ui], force_check: @force_check)

  record_mode = options[:record].to_s == 'true'
  scheme = 'StreamChatUI'
  remove_snapshots if record_mode
  update_testplan_on_ci(path: "Tests/#{scheme}Tests/#{scheme}.xctestplan")

  scan(
    project: xcode_project,
    scheme: scheme,
    testplan: scheme,
    clean: is_localhost,
    derived_data_path: derived_data_path,
    cloned_source_packages_path: source_packages_path,
    build_for_testing: options[:build_for_testing],
    skip_build: options[:skip_build],
    result_bundle: true,
    devices: options[:device],
    fail_build: !record_mode,
    xcodebuild_formatter: xcodebuild_formatter
  )

  if record_mode && is_ci
    png_files = git_status(ext: '.png').map { |_, png| png }.flatten
    next if png_files.empty?

    # Discard all files apart from the snapshots
    Dir.chdir('..') do
      png_files.each { |png| sh("git add #{png}") || true }
      sh('git restore .')
    end

    pr_create(
      title: '[CI] Snapshots',
      base_branch: current_branch,
      head_branch: "#{current_branch}-snapshots-#{Time.now.to_i}"
    )
  end
end

